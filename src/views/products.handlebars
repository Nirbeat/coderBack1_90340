<head>
    <link rel="stylesheet" href="{{style}}">
</head>

{{#if products}}
{{#each products}}
{{#if this.status}}
<p>{{this.id}} - {{this.title}} - {{this.price}} - {{this.stock}}</p>
{{else}}
<p>{{this.id}} - {{this.title}} - No disponible</p>
{{/if}}
{{/each}}
{{else}}
<p>No hay productos</p>
{{/if}}

<script src="/js/products.js"></script>