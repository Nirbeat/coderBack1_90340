<form action="/api/products" method="post" enctype="multipart/form-data">

    <input type="text" name="title" placeholder="titulo"><br>
    <input type="text" name="description" placeholder="descripcion"><br>
    <input type="number" name="price" placeholder="precio"><br>
    <input type="number" name="stock" placeholder="stock"><br>
    <input type="text" name="category" placeholder="categoria"><br>
    <input type="file" name="imagen" placeholder="imagen"><br>

    <button type="submit">Agregar</button>
</form>